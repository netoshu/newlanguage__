{
  "name": "newlanguage-gesture-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Gamepad gesture performance recorder and offline renderer.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "web": "npx serve .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "three": "^0.181.2"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "studio.newlanguage.gesture",
    "productName": "newlanguage_ Gesture Studio",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
